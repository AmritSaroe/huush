<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/huush_surface_light</item>
        <item name="android:windowBackground">@color/huush_surface_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/huush_surface_light</item>
        <item name="android:navigationBarColor">@color/huush_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/huush_surface_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/huush_surface_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_huush_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/huush_surface_light</item>
        <item name="android:windowBackground">@color/huush_surface_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/huush_surface_light</item>
        <item name="android:navigationBarColor">@color/huush_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Per-invocation action-mode styles applied immediately before Android inflates the selection toolbar. -->
    <style name="ReaderActionMode.Light" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/huush_action_mode_light</item>
        <item name="android:background">@color/huush_action_mode_light</item>
        <item name="titleTextStyle">@style/ReaderActionModeText.Dark</item>
        <item name="android:titleTextStyle">@style/ReaderActionModeText.Dark</item>
    </style>

    <style name="ReaderActionMode.Sepia" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/huush_action_mode_sepia</item>
        <item name="android:background">@color/huush_action_mode_sepia</item>
        <item name="titleTextStyle">@style/ReaderActionModeText.Dark</item>
        <item name="android:titleTextStyle">@style/ReaderActionModeText.Dark</item>
    </style>

    <style name="ReaderActionMode.Dark" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/huush_action_mode_dark</item>
        <item name="android:background">@color/huush_action_mode_dark</item>
        <item name="titleTextStyle">@style/ReaderActionModeText.Light</item>
        <item name="android:titleTextStyle">@style/ReaderActionModeText.Light</item>
    </style>

    <style name="ReaderActionModeText.Light" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">#F6F1E8</item>
    </style>

    <style name="ReaderActionModeText.Dark" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">#171716</item>
    </style>

    <style name="ActionModeOverlay_Light">
        <item name="actionModeStyle">@style/ReaderActionMode.Light</item>
        <item name="android:actionModeStyle">@style/ReaderActionMode.Light</item>
    </style>

    <style name="ActionModeOverlay_Sepia">
        <item name="actionModeStyle">@style/ReaderActionMode.Sepia</item>
        <item name="android:actionModeStyle">@style/ReaderActionMode.Sepia</item>
    </style>

    <style name="ActionModeOverlay_Dark">
        <item name="actionModeStyle">@style/ReaderActionMode.Dark</item>
        <item name="android:actionModeStyle">@style/ReaderActionMode.Dark</item>
    </style>
</resources>
