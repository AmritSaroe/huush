<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 and Android 16 use the same edge-to-edge layout. System-bar
         insets are applied by Capacitor's CSS mode to the bundled WebView. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/huush_surface_light</item>
        <item name="android:windowBackground">@color/huush_surface_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/huush_surface_light</item>
        <item name="android:navigationBarColor">@color/huush_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:dialogCornerRadius">@dimen/huush_selection_popup_corner_radius</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/huush_surface_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/huush_surface_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_huush_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/huush_surface_light</item>
        <item name="android:windowBackground">@color/huush_surface_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/huush_surface_light</item>
        <item name="android:navigationBarColor">@color/huush_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
